# Copy this file to .env.local and fill in your values. .env.local is never committed.

# Supabase project (Project Settings → API Keys). Use the publishable key, never the secret one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claude API key from https://console.anthropic.com. Without it, the app uses the rule-based parser.
ANTHROPIC_API_KEY=

# Push reminders. Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.example.com

# Shared secret between Supabase's scheduler and /api/reminders/send. Any long random string.
CRON_SECRET=
